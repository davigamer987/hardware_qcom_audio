cc_library_shared {
    name: "libOmxAmrEnc",
    vendor: true,

    srcs: [
        "src/aenc_svr.c",
        "src/omx_amr_aenc.cpp",
    ],

    header_libs: [
        "media_headers",
        "generated_kernel_headers",
    ],

    local_include_dirs: [
        "inc",
    ],

    cflags: [
        "-Wno-format",
        "-Wno-sign-compare",
        "-Wno-sign-conversion",
        "-Wno-self-assign",
        "-Wno-parentheses-equality",
    ],

    shared_libs: [
        "libutils",
        "liblog",
    ],
}
