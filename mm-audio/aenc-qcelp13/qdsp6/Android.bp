cc_library_shared {
    name: "libOmxQcelp13Enc",
    vendor: true,

    srcs: [
        "src/aenc_svr.c",
        "src/omx_qcelp13_aenc.cpp",
    ],

    cflags: [
        "-g",
        "-O3",
        "-DQC_MODIFIED",
        "-D_ANDROID_",
        "-D_ENABLE_QC_MSG_LOG_",
        "-DVERBOSE",
        "-D_DEBUG",
        "-Wconversion",
        "-DAUDIOV2",
        "-Wno-sign-conversion",
        "-Wno-shorten-64-to-32",
        "-Wno-self-assign",
        "-Wno-parentheses-equality",
        "-Wno-format",
        "-Wno-sign-compare",
        "-Wno-tautological-compare",
        "-Wno-unused-local-typedef",
    ],

    local_include_dirs: ["inc"],

    shared_libs: [
        "libutils",
        "liblog",
    ],

    header_libs: [
        "generated_kernel_headers",
        "media_headers",
    ],
}
